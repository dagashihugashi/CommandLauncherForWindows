{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows Maneuver",
  "version": "0.1.0",
  "identifier": "com.windows-maneuver.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Windows Maneuver",
        "width": 600,
        "height": 400,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "core:default",
      "global-shortcut:default",
      "global-shortcut:allow-register",
      "global-shortcut:allow-unregister",
      "core:window:allow-hide",
      "core:window:allow-show",
      "core:window:allow-set-focus",
      "icons/icon.ico"
    ]
  }
}